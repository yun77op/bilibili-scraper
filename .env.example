DEEPSEEK_API_KEY=sk-your-api-key
DEEPSEEK_MODEL=deepseek-v4-pro
# 需要代理时填写，例如 http://127.0.0.1:7897
BILIBILI_PROXY=
HTTP_PROXY=
HTTPS_PROXY=
HF_HUB_DISABLE_XET=1
WHISPER_DEVICE=cuda
WHISPER_COMPUTE_TYPE=float16
# 转写后端：groq | local。不填则配置了 GROQ_API_KEY 时走 Groq，否则本地 Whisper
TRANSCRIBE_PROVIDER=
GROQ_API_KEY=
GROQ_WHISPER_MODEL=whisper-large-v3-turbo
# 语种 ISO-639-1，如 zh / en；auto 或不填则 Groq 自动检测（本地 Whisper 默认 zh）
TRANSCRIBE_LANGUAGE=auto
# 登录会话签名密钥。不填则首次启动自动生成并写入 .env.local（勿泄露）
FLASK_SECRET_KEY=

# Google Drive（可选）——OAuth 客户端凭据路径。不填默认项目内 .gdrive-credentials.json，
# 其次兼容 ~/.gdrive-credentials.json（与旧版 / 独立 CLI 共用）
GDRIVE_CREDENTIALS_PATH=
# 旧版每用户 token 文件目录。现在 token 已存入数据库 jobs.db（gdrive_tokens 表），
# 此变量仅用于读取旧文件并自动迁移，新授权不再写文件
GDRIVE_TOKENS_DIR=
