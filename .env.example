DEEPSEEK_API_KEY=sk-your-api-key
DEEPSEEK_MODEL=deepseek-v4-flash
# 需要代理时填写，例如 http://127.0.0.1:7897
BILIBILI_PROXY=
HTTP_PROXY=
HTTPS_PROXY=
HF_HUB_DISABLE_XET=1
WHISPER_DEVICE=cuda
WHISPER_COMPUTE_TYPE=float16
# 转写后端：groq | local。不填则配置了 GROQ_API_KEY 时走 Groq，否则本地 Whisper
TRANSCRIBE_PROVIDER=
GROQ_API_KEY=
GROQ_WHISPER_MODEL=whisper-large-v3-turbo
# 语种 ISO-639-1，如 zh / en；auto 或不填则 Groq 自动检测（本地 Whisper 默认 zh）
TRANSCRIBE_LANGUAGE=auto
# 登录会话签名密钥。不填则首次启动自动生成并写入 .env.local（勿泄露）
FLASK_SECRET_KEY=

# Google 登录（可选）。同时填写 CLIENT_ID / CLIENT_SECRET 时优先用这对密钥；
# 否则尝试 GOOGLE_CREDENTIALS_PATH，再回退到项目内 .gdrive-credentials.json。
# 需在 Google Cloud Console 为「Web 应用」客户端添加重定向 URI：
#   https://bilibili-scraper.shuilong.uk/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CREDENTIALS_PATH=
# 对外访问根地址（OAuth 回调用）。生产示例：
# PUBLIC_BASE_URL=https://bilibili-scraper.shuilong.uk
PUBLIC_BASE_URL=

# Notion OAuth（可选）。创建 Public Integration 后填写；Redirect URI：
#   https://bilibili-scraper.shuilong.uk/api/notion/callback
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
